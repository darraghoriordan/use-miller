# These variables generally don't need to change for
# local development
WEB_PORT=34522
APP_POSTGRES_HOST=host.docker.internal
APP_POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=samplePassword
APP_POSTGRES_PORT=5410
APP_POSTGRES_LOGGING="false"
NODE_ENV=dev
TZ="UTC"
GENERATE_SWAGGER=true
FRONTEND_APP_URL=http://localhost:3000
BACKEND_APP_URL=http://localhost:34522
AUTO_INSTALL_API_MODELS=false
LOGGER_NAME="Backend App"

# Self-hosted Better Auth with Google as the only sign-in method. `mill setup
# --only auth --apply --yes` generates and preserves the signing secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:34522
BETTER_AUTH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPER_USER_EMAILS=

# These variables are set from input in the Miller init script
COMPOSE_PROJECT_NAME=
APP_POSTGRES_DATABASE=
APP_TITLE=
EMAIL_SENDER_NAME=

# We don't send email locally anyway  so these are fake
# but you can enter an smtp server later if you like!
SMTP_EMAIL_USERNAME=email_login
SMTP_EMAIL_PASSWORD=email_password
EMAIL_SYNC_SEND_ENABLED=false
SMTP_EMAIL_HOST="smtp.myserver.com"
SMTP_EMAIL_PORT=587
EXTRA_EMAIL_BCC=me@mymillerapp.com
EMAIL_SENDER_ADDRESS="hello@mymillerapp.dev"

STRIPE_ACCESS_TOKEN=
STRIPE_WEBHOOK_VERIFICATION_KEY=
STRIPE_REDIRECTS_BASE_URL=http://localhost:3000
# Server-authoritative catalog. Example:
# STRIPE_PRODUCT_CATALOG_JSON={"starter":{"priceId":"price_...","mode":"subscription","internalSku":"starter","displayName":"Starter"}}
STRIPE_PRODUCT_CATALOG_JSON=
# Optional compatibility fallback when STRIPE_PRODUCT_CATALOG_JSON is empty.
STRIPE_PRICE_MILLER_START=
STRIPE_PRICE_MILLER_START_CONSULTING=
STRIPE_PRICE_DEV_SHELL=
APP_MODULE_ENTITY_PATH="dist"
MIGRATIONS_PATH="dist"
CORE_MODULE_ENTITY_PATH="node_modules/@darraghor/nest-backend-libs/dist"
REDIS_URL=redis://:redis-pass@host.docker.internal:6379
DOCKER_REDIS_PORT=6379
INVITATION_URLS_BASE_URL=http://localhost:3000
COURSE_FILES_BASE_PATH="/Users/you/projects"
LOGGER_USE_PRETTY_LOGS=true
LOGGER_MIN_LEVEL="debug"
#NEST_DEBUG="true"
ENABLE_SUPER_POWERS=true
GITHUB_ACCESS_TOKEN="test"
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
OTEL_LOG_LEVEL=WARN
OTEL_SDK_DISABLED=false
HONEYCOMB_API_KEY=
